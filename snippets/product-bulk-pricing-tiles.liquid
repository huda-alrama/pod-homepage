{% comment %}
  Renders the bulk-pricing tile grid for the pdp_bulk_pricing block.
  Split out of sections/main-product.liquid to keep that file's Liquid
  complexity under the theme-check limit.

  Accepts:
  - block: {Object} the pdp_bulk_pricing block

  Usage:
  {% render 'product-bulk-pricing-tiles', block: block %}
{% endcomment %}
<div class="product__bulk-pricing-grid">
  <button type="button" class="product__bulk-pricing-tile is-selected" data-quantity="1">
    <span class="product__bulk-pricing-qty">{{ block.settings.tier_0_label }}</span>
  </button>
  {%- for i in (1..5) -%}
    {%- liquid
      case i
        when 1
          assign tier_qty = block.settings.tier_1_qty
          assign tier_label = block.settings.tier_1_label
          assign tier_discount = block.settings.tier_1_discount
        when 2
          assign tier_qty = block.settings.tier_2_qty
          assign tier_label = block.settings.tier_2_label
          assign tier_discount = block.settings.tier_2_discount
        when 3
          assign tier_qty = block.settings.tier_3_qty
          assign tier_label = block.settings.tier_3_label
          assign tier_discount = block.settings.tier_3_discount
        when 4
          assign tier_qty = block.settings.tier_4_qty
          assign tier_label = block.settings.tier_4_label
          assign tier_discount = block.settings.tier_4_discount
        when 5
          assign tier_qty = block.settings.tier_5_qty
          assign tier_label = block.settings.tier_5_label
          assign tier_discount = block.settings.tier_5_discount
      endcase
    -%}
    {%- if tier_label != blank -%}
      <button type="button" class="product__bulk-pricing-tile" data-quantity="{{ tier_qty }}">
        <span class="product__bulk-pricing-qty">{{ tier_label }}</span>
        {%- if tier_discount != blank -%}
          <span class="product__bulk-pricing-discount">{{ tier_discount }}</span>
        {%- endif -%}
      </button>
    {%- endif -%}
  {%- endfor -%}
</div>
