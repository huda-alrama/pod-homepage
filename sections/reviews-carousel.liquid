{{ 'section-reviews-carousel.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Reuses Dawn's own .rating/.rating-star component (assets/component-
  rating.css, same one used for product star ratings in snippets/card-
  product.liquid) for both the overall score header and each review's
  stars, and the same slider-component carousel pattern as bestsellers/
  template-cards — no new rating or carousel mechanism invented here.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="reviews-carousel__header">
      <div
        class="rating"
        role="img"
        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: section.settings.overall_rating, rating_max: 5 }}"
      >
        <span
          aria-hidden="true"
          class="rating-star color-icon-{{ settings.accent_icons }}"
          style="--rating: {{ section.settings.overall_rating | floor }}; --rating-max: 5; --rating-decimal: 0.5;"
        ></span>
      </div>
      <p class="reviews-carousel__score">{{ section.settings.overall_rating }} / 5</p>
      {%- if section.settings.review_count != blank -%}
        <p class="reviews-carousel__count">{{ section.settings.review_count }}</p>
      {%- endif -%}
    </div>

    <slider-component class="slider-mobile-gutter">
      <ul
        id="Slider-{{ section.id }}"
        class="grid reviews-carousel__grid grid--1-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop slider slider--desktop slider--tablet grid--peek"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="grid__item slider__slide" {{ block.shopify_attributes }}>
            <div class="review-card">
              <div
                class="rating"
                role="img"
                aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}"
              >
                <span
                  aria-hidden="true"
                  class="rating-star color-icon-{{ settings.accent_icons }}"
                  style="--rating: {{ block.settings.rating | floor }}; --rating-max: 5; --rating-decimal: 0;"
                ></span>
              </div>
              {%- if block.settings.text != blank -%}
                <p class="review-card__text">{{ block.settings.text }}</p>
              {%- endif -%}
              <p class="review-card__meta">
                {%- if block.settings.name != blank -%}<span class="review-card__name">{{ block.settings.name }}</span>{%- endif -%}
                {%- if block.settings.date != blank -%}<span class="review-card__date">{{ block.settings.date }}</span>{%- endif -%}
              </p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.blocks.size > section.settings.columns_desktop -%}
        <div class="slider-buttons no-js-hidden">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            {% render 'icon-caret' %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            {% render 'icon-caret' %}
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Reviews carousel",
  "settings": [
    {
      "type": "text",
      "id": "overall_rating",
      "label": "Overall rating",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count text",
      "default": "10.000+ Bewertungen"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Visible columns on desktop"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-2",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Rating"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
