{{ 'section-reviews-carousel.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Rebuilt to match the real spreadshirt.de reviews section exactly (per
  screenshot), which turned out to look quite different from a typical
  boxed-review-card carousel: flat text blocks with no card background/
  border, a single overall Trustpilot-branded score (not a star rating
  per review), large circular prev/next arrows at the outer edges of the
  whole section (not inline with the content), and a "view all reviews"
  button below the dots. Reuses the same <slider-component> carousel
  pattern as bestsellers/template-cards — only the visual treatment of
  the controls and cards differs here.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <h2 class="reviews-carousel__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="reviews-carousel__header">
      <p class="reviews-carousel__brand">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#00b67a" aria-hidden="true"><path d="M12 2l2.9 6.6L22 9.3l-5 4.9 1.4 7.1L12 17.8 5.6 21.3 7 14.2 2 9.3l7.1-.7z"/></svg>
        Trustpilot
      </p>
      <p class="reviews-carousel__score">{{ section.settings.overall_rating }} von 5</p>
    </div>

    <slider-component class="slider-mobile-gutter reviews-carousel__slider-component">
      {%- if section.blocks.size > section.settings.columns_desktop -%}
        <button type="button" class="reviews-carousel__arrow reviews-carousel__arrow--prev slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
          {% render 'icon-caret' %}
        </button>
      {%- endif -%}

      <ul
        id="Slider-{{ section.id }}"
        class="grid reviews-carousel__grid grid--1-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop slider slider--desktop slider--tablet grid--peek"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="grid__item slider__slide" {{ block.shopify_attributes }}>
            <div class="review-card">
              {%- if block.settings.title != blank -%}
                <p class="review-card__title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="review-card__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <p class="review-card__name">{{ block.settings.name }}</p>
              {%- endif -%}
              {%- if block.settings.date != blank -%}
                <p class="review-card__date">{{ block.settings.date }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > section.settings.columns_desktop -%}
        <button type="button" class="reviews-carousel__arrow reviews-carousel__arrow--next slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
          {% render 'icon-caret' %}
        </button>
        <div class="reviews-carousel__dots" id="ReviewsDots-{{ section.id }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="reviews-carousel__dot"
              data-dot-index="{{ forloop.index0 }}"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            >
              <span class="dot"></span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </slider-component>

    {%- comment -%}
      Self-contained dot navigation, scoped to this section only — not a
      modification to global.js's shared SliderComponent/SlideshowComponent
      classes. SlideshowComponent does support clickable dots, but its
      enableSliderLooping/onButtonClick edge-case logic assumes exactly one
      slide visible at a time (a true slideshow), not a multi-item-per-view
      grid like this carousel — reusing it here risked a second subtle bug
      of the same kind already found and fixed in the hero section.
    {%- endcomment -%}
    {%- if section.blocks.size > section.settings.columns_desktop -%}
      <script>
        (function () {
          var slider = document.getElementById('Slider-{{ section.id }}');
          var dotsWrap = document.getElementById('ReviewsDots-{{ section.id }}');
          if (!slider || !dotsWrap) return;
          var dots = Array.from(dotsWrap.querySelectorAll('[data-dot-index]'));
          var items = Array.from(slider.children);

          function setActiveDot() {
            var activeIndex = 0;
            var scrollLeft = slider.scrollLeft;
            items.forEach(function (item, i) {
              if (item.offsetLeft <= scrollLeft + 1) activeIndex = i;
            });
            dots.forEach(function (dot, i) {
              dot.classList.toggle('reviews-carousel__dot--active', i === activeIndex);
            });
          }

          dots.forEach(function (dot, i) {
            dot.addEventListener('click', function () {
              var item = items[i];
              if (item) slider.scrollTo({ left: item.offsetLeft, behavior: 'smooth' });
            });
          });

          slider.addEventListener('scroll', setActiveDot);
          setActiveDot();
        })();
      </script>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="reviews-carousel__cta">
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Reviews carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bewertungen von Trustpilot"
    },
    {
      "type": "text",
      "id": "overall_rating",
      "label": "Overall rating",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "View-all button label",
      "default": "Alle Bewertungen anzeigen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "View-all button link"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5,
      "label": "Visible columns on desktop"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review headline"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
