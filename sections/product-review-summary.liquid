{{ 'section-product-review-summary.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Big rating summary block for a product page — overall score, stars,
  review count, and a link to read more. Only renders when the
  product's real reviews.rating metafield has data; no per-attribute
  breakdown (quality/fit/comfort) since that needs a reviews app this
  store doesn't have wired up yet.
{%- endcomment -%}

{%- if product.metafields.reviews.rating.value != blank -%}
  {%- liquid
    assign rating_decimal = 0
    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif
  -%}
  <div class="color-{{ section.settings.color_scheme }}">
    <div class="page-width section-{{ section.id }}-padding product-review-summary">
      <p class="product-review-summary__score">{{ product.metafields.reviews.rating.value }}</p>
      <div
        class="rating"
        role="img"
        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
      >
        <span
          aria-hidden="true"
          class="rating-star color-icon-{{ settings.accent_icons }}"
          style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
        ></span>
      </div>
      <p class="product-review-summary__count">
        {{ product.metafields.reviews.rating_count }} {{ section.settings.reviews_label }}
      </p>
      {%- if section.settings.subheading != blank -%}
        <p class="product-review-summary__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#reviews' }}"
          class="button button--primary product-review-summary__button"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Review summary",
  "settings": [
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Reviews label",
      "default": "Bewertungen"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Feedback aus der Community"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Mehr Bewertungen lesen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-2",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Review summary"
    }
  ]
}
{% endschema %}
